# Frontend Environment Variables
# Copy this file to .env and update with your values.
# All VITE_ variables are baked into the JS bundle at build time.

# ── API ─────────────────────────────────────────────────────────────────────
# Use /api in both dev (Vite proxy) and on Vercel (serverless function rewrite)
VITE_API_URL=/api

# ── Site ─────────────────────────────────────────────────────────────────────
# Used for canonical URLs and Open Graph tags
VITE_SITE_URL=https://yourdomain.com

# ── Clinic Information ────────────────────────────────────────────────────────
VITE_CLINIC_NAME=Your Clinic Name
VITE_CLINIC_DOCTOR=Dr. Your Name
VITE_CLINIC_QUALIFICATION=BDS, MDS (Prosthodontics)
VITE_CLINIC_EXPERIENCE=10+ Years
VITE_CLINIC_ADDRESS=Your Full Address
VITE_CLINIC_CITY=Your City
VITE_CLINIC_PHONE=+91 9999999999
# WhatsApp number in international format WITHOUT + (e.g. 919999999999)
VITE_CLINIC_WHATSAPP=919999999999
VITE_CLINIC_EMAIL=contact@yourclinic.com
VITE_CLINIC_HOURS_WEEKDAYS=Mon – Sat:  9:00 AM – 7:00 PM
VITE_CLINIC_HOURS_SUNDAY=Sunday: 9:00 AM – 1:30 PM
# Google Maps embed src — get from Google Maps → Share → Embed a map
VITE_CLINIC_MAP_EMBED=https://www.google.com/maps/embed?pb=...
# URL-encoded prefilled WhatsApp message
VITE_CLINIC_WHATSAPP_MSG=Hi%2C%20I%20would%20like%20to%20book%20an%20appointment.
# Optional: override the doctor bio paragraph (leave blank to auto-generate)
VITE_CLINIC_DOCTOR_BIO=

# ── Social Media ─────────────────────────────────────────────────────────────
# Leave blank to hide the icon in the footer
VITE_SOCIAL_FACEBOOK=https://facebook.com/yourclinic
VITE_SOCIAL_INSTAGRAM=https://instagram.com/yourclinic
VITE_SOCIAL_TWITTER=https://twitter.com/yourclinic
