# Server Environment Variables
# Copy this file to .env and fill in your values.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/clinic

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# For Vercel: use your Vercel project URL, e.g. https://your-project.vercel.app
ALLOWED_ORIGINS=https://yourdomain.com,https://your-project.vercel.app

# ── Admin Credentials (CHANGE THESE!) ───────────────────────────────────
ADMIN_USERNAME=admin
# Option A: plain-text password (development only)
ADMIN_PASSWORD=changeme
# Option B: bcrypt hash (recommended for production — takes precedence over ADMIN_PASSWORD)
# Generate: node -e "const b=require('bcryptjs');b.hash('yourpassword',12).then(console.log)"
# ADMIN_PASSWORD_HASH=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Use a long, random secret (e.g. openssl rand -hex 64)
JWT_SECRET=change_this_to_a_very_long_random_secret_string_in_production
JWT_EXPIRES_IN=8h

# ── Clinic Info (used in server logs / emails) ─────────────────────────────
CLINIC_NAME=Your Clinic Name
CLINIC_PHONE=+91 9999999999
CLINIC_EMAIL=contact@yourclinic.com
